<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0-android;net6.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Anjo.Android.BrainTree.DropIn</PackageId>
		<PackageVersion>6.10.0</PackageVersion>
		<AssemblyVersion>6.10.0</AssemblyVersion>
		<FileVersion>6.10.0</FileVersion>
		<Version>6.10.0</Version>
		<Title>Anjo Android BrainTree DropIn SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.BrainTree</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - BrainTree DropIn SDK</Description>
		<PackageReleaseNotes>BrainTree.DropIn SDK v6.10.0</PackageReleaseNotes>
		<Copyright>Copyright (c) 2023 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, Braintree, PayPal, UnionPay, Venmo, GooglePay, Payment Gateway, global payments</PackageTags>
		<Summary>Build with Braintree Resources and tools for developers to integrate Braintree's global payments platform.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="Jars\drop-in-6.10.0.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.6.0.4" />
		<PackageReference Include="Xamarin.AndroidX.CardView" Version="1.0.0.21" />
		<PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.1.4.6" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.6.1" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.6.1.3" />
		<PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.1" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.9.0.2" />
		<PackageReference Include="Xamarin.GooglePlayServices.Wallet" Version="119.2.0.1" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="1.9.0.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\BrainTreeBrowserSwitch\BrainTreeBrowserSwitch.csproj" />
		<ProjectReference Include="..\BrainTreeCardForm\BrainTreeCardForm.csproj" />
		<ProjectReference Include="..\BrainTreeCard\BrainTreeCard.csproj" />
		<ProjectReference Include="..\BrainTreeCore\BrainTreeCore.csproj" />
		<ProjectReference Include="..\BrainTreeDataCollector\BrainTreeDataCollector.csproj" />
		<ProjectReference Include="..\BrainTreeGooglePay\BrainTreeGooglePay.csproj" />
		<ProjectReference Include="..\BrainTreePayPal\BrainTreePayPal.csproj" />
		<ProjectReference Include="..\BrainTreeThreeDSecure\BrainTreeThreeDSecure.csproj" />
		<ProjectReference Include="..\BrainTreeUnionPay\BrainTreeUnionPay.csproj" />
		<ProjectReference Include="..\BrainTreeVenmo\BrainTreeVenmo.csproj" />
		<ProjectReference Include="..\PayPalDataCollector\PayPalDataCollector.csproj" />
		<ProjectReference Include="..\SharedUtilities\SharedUtilities.csproj" />
	</ItemGroup>
</Project>