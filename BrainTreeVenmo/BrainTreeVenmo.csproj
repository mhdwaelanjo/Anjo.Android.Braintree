<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net7.0-android;net6.0-android;</TargetFrameworks>
		<SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup> 
	<PropertyGroup>
		<PackageId>Anjo.Android.BrainTree.Venmo</PackageId>
		<PackageVersion>4.38.2</PackageVersion>
		<AssemblyVersion>4.38.2</AssemblyVersion>
		<FileVersion>4.38.2</FileVersion>
		<Version>4.38.2</Version>
		<Title>Anjo Android BrainTree Venmo SDK</Title>
		<Authors>Wael Anjo</Authors>
		<Owners>Wael Anjo</Owners>
		<PackageProjectUrl>https://github.com/mhdwaelanjo/Anjo.Android.BrainTree</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<Description>.NET for Android (formerly Xamarin.Android) Binding Library - BrainTree Venmo SDK</Description>
		<PackageReleaseNotes>BrainTree.Venmo SDK v4.38.2</PackageReleaseNotes>
		<Copyright>Copyright (c) 2023 Wael Anjo</Copyright>
		<PackageTags>Xamarin.Android, Braintree, PayPal, UnionPay, Venmo, GooglePay, Payment Gateway, global payments</PackageTags>
		<Summary>Build with Braintree Resources and tools for developers to integrate Braintree's global payments platform.</Summary>
		<!-- Include symbol files (*.pdb) in the built .nupkg -->
		<AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup> 
	<ItemGroup>
	  <None Remove="Jars\venmo-4.38.2.aar" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.4" />
		<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk7" Version="1.9.10.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\BrainTreeCore\BrainTreeCore.csproj" />
	</ItemGroup>
</Project>